generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Diccionario de Datos (Campos)
model FieldMetadata {
  id            String   @id @default(uuid())
  fieldName     String   @unique // Ej: "cedularif"
  description   String   // Ej: "Identificador del cliente"
  dataType      String   // Ej: "Alfanumérico", "Numérico"
  isMandatory   Boolean  @default(true) 
  businessValue String?  
  length        String?  // Ej: "5", "10", "20"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 2. Diccionario de Códigos de Respuesta y Errores (¡NUEVO!)
model ResponseCodeMetadata {
  id          String   @id @default(uuid())
  code        String   @unique // Ej: "00", "01", "400", "500"
  description String   // Ej: "Aprobado", "Cuenta inválida", "Error de conexión"
  type        String   // Ej: "EXITO", "ERROR_NEGOCIO", "ERROR_SISTEMA"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 3. Gestión de Ambientes
model Environment {
  id        String   @id @default(uuid())
  name      String
  variables String   // JSON string
  createdAt DateTime @default(now())
}

// 4. Gestión de Colecciones (Carpetas)
model Folder {
  id        String        @id @default(uuid())
  name      String
  requests  RequestItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// 5. Peticiones de las Colecciones
model RequestItem {
  id        String   @id @default(uuid())
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name      String
  method    String
  url       String
  headers   String   // JSON string of headers array
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 6. Exportación a Chat
model CollectionExport {
  id             String   @id @default(uuid())
  folderName     String
  collectionJson String   // JSON string
  createdAt      DateTime @default(now())
}
